*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.pyright_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
